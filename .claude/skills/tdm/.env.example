# ============================================================
# TDMDO 環境變數配置範例
# 複製此檔為 .env 並修改參數：
#   cp .env.example .env
#
# 載入順序：系統環境變數 > .env 檔案 > 預設值
# ============================================================

# 影片下載目錄（支援絕對路徑或相對於 skill 目錄的路徑）
# 預設: <skill>/downloads 或 <project>/downloads
TDM_DOWNLOAD_DIR=D:/Videos/TDM

# SQLite 資料庫路徑（僅 CLI 工具使用）
# 預設: <skill>/scripts/tdm_news.db
# TDM_DB_PATH=D:/CODE/TDMDO/.claude/skills/tdm/scripts/tdm_news.db

# ============================================================
# 遠端伺服器模式（多機共用一台 Server）
#
# 設定後 CLI 所有操作自動走 HTTP 調用遠端 Flask 伺服器。
# 客戶端只需 pip install requests，不需 SQLite / ffmpeg / flask。
#
# 使用步驟：
#   1. Server 機：python app/tdm_web.py --host 0.0.0.0 --port 8080
#   2. 客戶端機：設定 TDM_SERVER=http://<server_ip>:8080
#   3. 照常使用 CLI：tdm_tool.py news / search / download / ...
#
# 也可用命令列參數（一次性）：--server http://192.168.1.100:8080
# ============================================================

# 遠端伺服器 URL（含 http:// 及埠號）
# 未設定時走本地模式（需要 SQLite + ffmpeg）
TDM_SERVER=

# 遠端伺服器啟用 WEB_AUTH_ENABLED 時，CLI 自動登入使用的密碼
# 建議只透過 HTTPS 或可信任內網傳送；不設定時遇到 401 會直接報錯
TDM_SERVER_PASSWORD=

# 遠端影片下載進度的總輪詢逾時秒數（預設 600）
TDM_REMOTE_POLL_TIMEOUT=600

# ============================================================
# WebDAV 自動推送（可選）
# 下載完成後透過 WebDAV 協議上傳到 Alist / OpenAlist
#
# 優點：HTTP Basic Auth，無 JWT，跨平台相容
# 前置：Alist 後台 → 用戶 → 勾選「WebDAV 讀寫」權限
# ============================================================

# 是否啟用自動推送 (true/false)
WEBDAV_ENABLED=false

# WebDAV 伺服器 URL（支援 Alist / OpenAlist）（含埠號）
WEBDAV_URL=http://192.168.1.100:5244

# WebDAV 專用上傳帳號
WEBDAV_USERNAME=tdmdo

# WebDAV 專用上傳密碼
WEBDAV_PASSWORD=your_password_here

# WebDAV 上傳目標目錄
WEBDAV_PATH=/TDM新聞/

# ============================================================
# Telegram 推送（通用推送模組 push_manager.py）
# 支援：文字 / 影片 / 圖片 / 文件
# ============================================================

# 是否啟用推送功能 (true/false)
PUSH_ENABLED=true

# 預設推送通道，逗號分隔 (tg = Telegram)
PUSH_DEFAULT_TARGET=tg

# Telegram Bot Token（從 @BotFather 取得）
TG_TOKEN=

# Telegram Chat ID（個人/群組/頻道 ID）
# 個人: 9 位數字 | 群組: - 開頭（如 -4001234567）| 頻道: -100 開頭
TG_CHATID=

# ============================================================
# Web 頁面密碼保護
# 為 TDMDO 網頁端添加簡單的密碼保護層
# ============================================================

# 是否啟用密碼保護 (true/false)，關閉時所有人可訪問
WEB_AUTH_ENABLED=true

# 允許訪問的密碼，多個用逗號分隔
# 啟用後訪問頁面需輸入任一密碼，密碼存儲在瀏覽器 Cookie 中
WEB_AUTH_PASSWORDS=your_password_here
