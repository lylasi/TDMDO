# ============================================================
# TDMDO 全域環境變數配置範例（專案根目錄）
#
# 複製此檔案為專案根目錄下的 .env 並修改對應設定：
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════
# 載入優先順序（由高至低，前者優先）：
#   1. 系統環境變數（Shell export / set 或命令列臨時變數，最高）
#   2. 專案根目錄 .env（即本檔案對應的 <project_root>/.env，推薦集中管理）
#   3. Skill 目錄 .env（.claude/skills/tdm/.env，向下相容專用）
#   4. 當前工作目錄 .env（Path.cwd()/.env，防禦性保底）
#   5. 程式碼內建預設值（Default Fallbacks）
# ============================================================

# ------------------------------------------------------------
# 1. 儲存與檔案路徑配置
# ------------------------------------------------------------

# 影片下載儲存目錄
# - 支援絕對路徑（如 D:/Videos/TDM 或 /var/media/tdm）
# - 支援相對路徑（如 downloads，統一相對於專案根目錄解析）
# - 若未設定，預設為: <專案根>/.claude/skills/tdm/downloads
# - Web 服務與 Skill CLI 均遵循此配置；Web 服務會限制所有檔案存取在此目錄內
TDM_DOWNLOAD_DIR=downloads

# SQLite 新聞與影片資料庫檔案路徑（本地模式使用）
# - 支援絕對路徑或相對路徑（相對路徑相對於專案根目錄）
# - 若未設定，預設為: <專案根>/.claude/skills/tdm/scripts/tdm_news.db
# TDM_DB_PATH=.claude/skills/tdm/scripts/tdm_news.db


# ------------------------------------------------------------
# 2. 遠端伺服器模式（CLI / Agent 遠端調用專用）
#
# 當客戶端機器未安裝 ffmpeg / SQLite，或多機共用一台伺服器時使用。
# 設定 TDM_SERVER 後，CLI 與 Skill 操作自動透過 HTTP API 走遠端伺服器。
#
# 運作方式：
#   1. Server 端執行：python app/tdm_web.py --host 0.0.0.0 --port 8080
#   2. 客戶端設定：TDM_SERVER=http://<server_ip>:8080
#   3. 客戶端即可直接執行新聞查詢、下載、裁剪與推播
# ------------------------------------------------------------

# 遠端伺服器 URL（含協議與埠號，例如 http://192.168.1.100:8080）
# 留空則為本地模式（需要在本機安裝 ffmpeg、sqlite3）
TDM_SERVER=

# 遠端伺服器認證密碼（當伺服器端啟用 WEB_AUTH_ENABLED 時必需）
# 客戶端連線時會自動以此密碼登入換取 Session / Cookie
TDM_SERVER_PASSWORD=

# 遠端非同步下載進度輪詢總逾時秒數（預設 600 秒）
TDM_REMOTE_POLL_TIMEOUT=600


# ------------------------------------------------------------
# 3. Web 網頁端服務配置（app/tdm_web.py）
# ------------------------------------------------------------

# 是否啟用 Web 頁面與 API 密碼保護 (true/false)
# - false: 所有人皆可直接存取網頁及 API（適合受信任個人本機）
# - true:  存取頁面或調用 API 需驗證密碼（密碼驗證後寫入 HTTP-only Cookie）
WEB_AUTH_ENABLED=true

# 允許通過驗證的密碼清單
# - 支援多組密碼，使用半形逗號分隔，例如: admin123,user456
# - 當 WEB_AUTH_ENABLED=true 時必須設定，否則保護將自動停用
WEB_AUTH_PASSWORDS=your_password_here


# ------------------------------------------------------------
# 4. WebDAV 自動推送配置（可選）
#
# 影片下載或裁剪完成後，自動上傳至 Alist / OpenAlist / Nextcloud 等 WebDAV 服務。
# ------------------------------------------------------------

# 是否啟用 WebDAV 自動推送 (true/false)
WEBDAV_ENABLED=false

# WebDAV 伺服器端點（支援 HTTP / HTTPS，包含埠號）
WEBDAV_URL=http://192.168.1.100:5244

# WebDAV 登入帳號
WEBDAV_USERNAME=tdmdo

# WebDAV 登入密碼
WEBDAV_PASSWORD=your_webdav_password

# WebDAV 遠端儲存目錄路徑（前後需帶斜線，需確保遠端目錄已存在）
WEBDAV_PATH=/TDM新聞/


# ------------------------------------------------------------
# 5. 通用推送配置（Telegram 通道 / push_manager.py）
#
# 支援推播類型：純文字、影片 (.mp4/.mkv ≤50MB)、圖片 (≤10MB)、文件 (≤50MB)。
# ------------------------------------------------------------

# 是否啟用推送功能 (true/false)
PUSH_ENABLED=true

# 預設推播目標通道（目前內建支援 tg，多通道用逗號分隔）
PUSH_DEFAULT_TARGET=tg

# Telegram Bot Token（向 @BotFather 申請建立機器人取得）
TG_TOKEN=

# Telegram 接收者 Chat ID（個人 ID、群組 ID 或頻道 ID）
# - 個人 ID: 通常為 9~10 位正整數
# - 群組 ID: 負整數（如 -4001234567）
# - 頻道 ID: 通常以 -100 開頭的負整數
TG_CHATID=
